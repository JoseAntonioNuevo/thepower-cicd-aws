# Configuración LOCAL. Copia a .env solo si quieres probar el modo real; no compartas ese archivo.
# En GitHub la clave no sale de aquí: es el secreto OPENROUTER_API_KEY del repositorio y solo
# lo usa el job «Evaluación». La imagen publicada arranca siempre en modo demo.
API_MODE=demo
APP_VERSION=desarrollo-local
# Solo para API_MODE=real o para evaluar el modelo real (consume un modelo de pago):
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_PROVIDER=openai/fast
OPENROUTER_API_KEY=pega_aqui_tu_clave
